# RHCSA Practice Labs - Environment Configuration
# Copy this file to .env and customize as needed.
# All values shown are defaults.

# =============================================================================
# Server Configuration
# =============================================================================

# Host to bind the server to (0.0.0.0 for all interfaces)
RHCSA_HOST=0.0.0.0

# Port to listen on
RHCSA_PORT=8080

# Enable debug mode (never use in production!)
RHCSA_DEBUG=false

# Secret key for session encryption (CHANGE THIS IN PRODUCTION)
RHCSA_SECRET_KEY=dev-secret-change-in-production

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
RHCSA_LOG_LEVEL=INFO

# Log format (Python logging format string)
# RHCSA_LOG_FORMAT=%(asctime)s [%(levelname)s] %(message)s

# =============================================================================
# Database Paths
# =============================================================================

# SQLite database for session storage
# RHCSA_SESSIONS_DB=/path/to/sessions.db

# SQLite database for grading results
# RHCSA_RESULTS_DB=/path/to/results.db

# SQLite database for flashcard progress
# RHCSA_FLASHCARDS_DB=/path/to/flashcards.db

# =============================================================================
# SSH Configuration
# =============================================================================

# Default SSH connection timeout in seconds
RHCSA_SSH_TIMEOUT=30

# SSH connection establishment timeout
RHCSA_SSH_CONNECT_TIMEOUT=10

# Default SSH user for VM connections
RHCSA_SSH_USER=root

# Default SSH port
RHCSA_SSH_PORT=22

# =============================================================================
# Session Management
# =============================================================================

# Default session timeout in minutes
RHCSA_SESSION_TIMEOUT=120

# Maximum session timeout in minutes
RHCSA_SESSION_MAX_TIMEOUT=480

# Interval for session cleanup checks (seconds)
RHCSA_CLEANUP_INTERVAL=300

# Interval for VM health checks (seconds)
RHCSA_HEALTH_CHECK_INTERVAL=60

# =============================================================================
# Static VMs (Alternative to Cloud)
# =============================================================================
# For local VMs, create a static_vms.json file instead of using these.
# See docs/local-vm-setup.md for details.
#
# Example static_vms.json:
# {
#   "enabled": true,
#   "node1_ip": "192.168.99.11",
#   "node2_ip": "192.168.99.12",
#   "ssh_user": "root",
#   "ssh_password": "vagrant"
# }
